<?xml version="1.0" encoding="utf-8"?>
<extension version="4.0" type="plugin" group="system" method="upgrade">
    <name>PLG_SYSTEM_RINENHEAD</name>
    <author>Rinenweb</author>
    <creationDate>20 July 2026</creationDate>
    <license>GNU General Public License version 3 or later; see LICENSE.txt</license>
    <authorEmail>info@rinenweb.eu</authorEmail>
    <authorUrl>https://www.rinenweb.eu</authorUrl>
    <version>1.2</version>
    <description>PLG_SYSTEM_RINENHEAD_XML_DESCRIPTION</description>
    <files>
        <filename plugin="rinenhead">rinenhead.php</filename>
    </files>
    <languages>
        <language tag="en-GB">language/en-GB/plg_system_rinenhead.ini</language>
        <language tag="en-GB">language/en-GB/plg_system_rinenhead.sys.ini</language>
        <language tag="el-GR">language/el-GR/plg_system_rinenhead.ini</language>
        <language tag="el-GR">language/el-GR/plg_system_rinenhead.sys.ini</language>
    </languages>
    <config>
        <fields name="params">
            <fieldset name="basic">
                <field name="customhtml" type="textarea" filter="raw" default="" label="PLG_SYSTEM_RINENHEAD_FIELD_CUSTOMHTML_LABEL" description="PLG_SYSTEM_RINENHEAD_FIELD_CUSTOMHTML_DESC" rows="10" cols="40" />
                <field name="customjs" type="textarea" filter="raw" default="" label="PLG_SYSTEM_RINENHEAD_FIELD_CUSTOMJS_LABEL" description="PLG_SYSTEM_RINENHEAD_FIELD_CUSTOMJS_DESC" rows="10" cols="40" />
            </fieldset>
        </fields>
    </config>
    <updateservers>
	<server type="extension" name="RinenHead Plugin updates">https://raw.githubusercontent.com/rinenweb/plg_rinenhead/main/manifest.xml</server>
    </updateservers>
</extension>
